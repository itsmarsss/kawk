# Bun loads this file after you copy it to .env. Never commit .env.
TYPESAFE_API_KEY=
KAWK_JEV_MODEL=jev-1.13.0
# Direct OpenAI API is the default for main and child agents.
KAWK_MODEL_PROVIDER=openai
OPENAI_API_KEY=
KAWK_OPENAI_MODEL=gpt-5.6-sol
KAWK_OPENAI_REASONING=none
# Optional legacy comparison: set KAWK_MODEL_PROVIDER=codex.
# Codex CLI owns subscription authentication: run codex login if needed.
# Omit KAWK_CODEX_MODEL to use the CLI default model.
# KAWK_CODEX_MODEL=
# Explicitly applied to main and child turns; never inherits CLI effort defaults.
KAWK_CODEX_REASONING=none
# Local bounded JSONL traces + Codex loopback OTLP timings. Set 0 to disable.
KAWK_TELEMETRY=1
# Authorized fallback: select an available tool-calling Baseten model explicitly.
BASETEN_API_KEY=
KAWK_BASETEN_MODEL=
KAWK_DATA_DIR=data
KAWK_RETENTION_DAYS=7
# Keep raw transcripts until explicitly deleted. Set days > 0 to expire them.
KAWK_TRANSCRIPT_RETENTION_DAYS=0
# Defaults to this computer's timezone; used for calendar/reminder interpretation.
KAWK_TIME_ZONE=America/Toronto
KAWK_STORAGE_MB=1024
KAWK_PORT=8091
KAWK_OWNER=local-wearer
KAWK_RUNNER=local
# Browser navigation/read/screenshot work with 0; interaction needs 1.
KAWK_BROWSER_INTERACTION=0
# Omit token to create data/client-token with mode 0600.
# KAWK_CLIENT_TOKEN=

# Capture and PWA. Set 0 during a Baseten outage (also disables model fallback).
KAWK_BASETEN_ENABLED=1
BASETEN_FACE_MODEL_ID=qvm6y6eq
BASETEN_STT_MODEL_ID=wdlg2oe3
