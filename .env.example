# Server-side only. Never put these values in browser JavaScript.
BASETEN_API_KEY=
BASETEN_SAM_MODEL_ID=
BASETEN_FACE_MODEL_ID=
# Existing Team 2 production streaming Whisper service:
BASETEN_STT_MODEL_ID=wdlg2oe3
TYPESAFE_API_KEY=
# Temporary browser V1: rules by default. typesafe requires TYPESAFE_API_KEY
# in the server environment; it gates live speech/significant clips with Jev.
# Missing/invalid credentials never silently fall back to rules.
REMEMBER_V1_DECISIONS=rules
# Needed only during SAM image build/model download; accept the upstream license.
HF_ACCESS_TOKEN=
# Local folder containing models/buffalo_l/*.onnx (default data):
REMEMBER_FACE_MODEL_ROOT=data
# Local perception model cache (not committed):
REMEMBER_MODEL_DIR=data/models
# Explicit experimental SAM window mode; IDs reset every window:
REMEMBER_SAM_ALLOW_WINDOWED=0
REMEMBER_YOLO_DEVICE=cpu
