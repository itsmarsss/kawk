# Main path uses the OpenAI API. Load OPENAI_API_KEY from private local config.
MEMORY_MODEL_PROVIDER=responses
MEMORY_MODEL=gpt-5.6-terra
# One bounded recovery attempt; set 1 for single-attempt benchmarks.
MEMORY_MODEL_ATTEMPTS=2
# Optional separate text writer; unset uses MEMORY_MODEL for both operations.
# MEMORY_WRITER_MODEL=gpt-5.6-luna
MEMORY_UPDATE_FORMAT=simple
# Experimental two-stage visual structuring and memory binding; needs new image observations.
# MEMORY_UPDATE_FORMAT=binding
MEMORY_TRANSCRIPT_WORDS=200
MEMORY_VISION_CONCURRENCY=4
MEMORY_UPDATE_BATCH_SIZE=4
MEMORY_BATCH_WAIT_MS=0
# The model reads text directly in simple mode. Native OCR is for other R&D formats only.
MEMORY_TEXT_READER=off
MEMORY_PERCEPTION_URL=http://127.0.0.1:8081
HOST=0.0.0.0
PORT=8082
# MEMORY_DATA_DIR=/absolute/path/to/private/memory-data
# Keep the key outside the repository; this file is documentation, not loaded automatically.
# OPENAI_API_KEY=
# Alternative R&D transport using the signed-in Codex CLI:
# MEMORY_MODEL_PROVIDER=codex
