{
  "name": "@kawk/memory",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "predev": "npm run build:client",
    "dev": "tsx src/main.ts",
    "start": "node dist/src/main.js",
    "build": "tsc -p tsconfig.json && npm run build:client",
    "build:client": "esbuild client/src/main.ts --bundle --format=esm --target=es2022 --outfile=public/client.js",
    "build:ocr": "node scripts/build-ocr.mjs",
    "check:client": "tsc -p client/tsconfig.json",
    "test:client": "tsx --test client/test/*.test.ts",
    "test": "tsx --test test/*.test.ts",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "@huggingface/transformers": "4.3.0",
    "better-sqlite3": "12.4.1",
    "express": "5.1.0",
    "sqlite-vec": "0.1.6",
    "write-file-atomic": "7.0.1",
    "ws": "8.21.3",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.13",
    "@types/express": "5.0.5",
    "@types/node": "22.18.10",
    "@types/write-file-atomic": "4.0.3",
    "@types/ws": "8.18.1",
    "esbuild": "0.25.11",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  }
}
